{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.10.7/.schema/devbox.schema.json",
  "packages": [
    "zig@0.15.1",
    "zls@0.15.0",
    "watchexec@latest"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!'",
      "devbox run"
    ],
    "scripts": {
      "test": [
        "zig build test"
      ],
      "test-watch": [
        "watchexec --exts zig --ignore .zig-cache -c -- zig build test"
      ],
      "build": [
        "zig build"
      ],
      "run": [
        "zig build run"
      ]
    }
  }
}
