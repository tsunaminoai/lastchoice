{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.10.7/.schema/devbox.schema.json",
  "packages": [
    "zig@0.12.0",
    "zls@latest",
    "watchexec@latest"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!'",
      "devbox run"
    ],
    "scripts": {
      "test": [
        "zig build test"
      ],
      "test-watch": [
        "if [ @ -z $1 ]; then FILTER=''; else FILTER='--filter $1'; fi",
        "watchexec --exts zig --watch src 'clear && zig build test $FILTER'"
      ],
      "build": [
        "zig build"
      ],
      "run": [
        "zig build run"
      ]
    }
  }
}
